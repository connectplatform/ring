{
  "name": "ring",
  "version": "1.101.0",
  "private": true,
  "type": "module",
  "bin": {
    "ring": "../cli/index.js"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation' node --import tsx server.ts",
    "dev:portal": "NODE_OPTIONS='--no-deprecation' node --import tsx server.ts",
    "type-check": "tsc --noEmit",
    "build": "npm run ensure:config && npm run type-check && NODE_OPTIONS='--no-deprecation' next build",
    "build:skip-types": "SKIP_TYPE_CHECK=1 next build",
    "build:portal": "NODE_OPTIONS='--no-deprecation' next build",
    "start": "NODE_OPTIONS='--no-deprecation' node --import tsx server.ts",
    "start:portal": "PORT=3000 npm run start",
    "lint": "next lint",
    "clean": "rm -rf .next node_modules/.cache",
    "build:clean": "npm run clean && npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "debug": "NODE_OPTIONS='--no-deprecation --inspect' next dev",
    "setup": "node ../scripts/setup-env.js",
    "setup:env": "node ../scripts/setup-env.js",
    "setup:new": "node ../scripts/setup-env.js --force",
    "setup:portal": "cp env.local.template .env.local",
    "config:firebase": "node ../scripts/inject-firebase-config.js",
    "validate:fcm-env": "node ../scripts/validate-fcm-env.mjs",
    "validate:fcm-schema": "node ../scripts/validate-fcm-schema.mjs",
    "db:apply-schema": "./../scripts/setup-clone-db.sh --database-url \"${DATABASE_URL:?Set DATABASE_URL}\"",
    "db:setup": "./install.sh setup-db",
    "db:flatten-schema": "./../scripts/flatten-schema-from-migrations.sh",
    "analyze": "ANALYZE=true npm run build:skip-types",
    "analyze:server": "BUNDLE_ANALYZE=server npm run build:skip-types",
    "analyze:browser": "BUNDLE_ANALYZE=browser npm run build:skip-types",
    "seed:opportunities": "node --experimental-modules ../scripts/seed-opportunities.js",
    "seed:portal": "node ../scripts/seed-portal-data.js",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "optimize:firebase": "node ../scripts/optimize-firebase-usage.js",
    "migrate:services": "node ../scripts/migrate-services-to-optimized.js",
    "fix:service-migration": "node ../scripts/fix-service-migration.js",
    "fix:compilation-errors": "node ../scripts/fix-remaining-compilation-errors.js",
    "test:firebase-optimization": "node ../scripts/test-firebase-optimization.js",
    "build:optimized": "BUILD_CACHE_DEBUG=true FIREBASE_DEBUG_LOGS=true npm run build && echo '📊 Check build logs for Firebase optimization results'",
    "build:analyze-performance": "BUILD_CACHE_DEBUG=true FIREBASE_DEBUG_LOGS=true time npm run build",
    "portal:health": "node ../scripts/check-portal-health.js",
    "portal:analytics": "node ../scripts/generate-portal-analytics.js",
    "cli:install": "cd ../cli && npm install && npm link",
    "cli:dev": "node ../cli/index.js",
    "smoke:pipelines": "./../scripts/run-all-smokes.sh",
    "type-check:smoke": "npm run type-check && npm run smoke:pipelines",
    "solana:create-mint": "node --import tsx ../scripts/solana/create-ring-mint.ts",
    "ci:layer1": "bash ../scripts/run-org-ci.sh layer1-forge-build-deploy.sh",
    "ci:layer1:dry": "bash ../scripts/run-org-ci.sh layer1-forge-build-deploy.sh --dry-run",
    "push:layer1": "bash ../scripts/run-org-ci.sh push-layer1.sh",
    "push:forgejo": "bash ../scripts/push-forgejo.sh",
    "push:github-oss": "bash ../scripts/push-github-oss.sh",
    "compose:shadow": "node ../scripts/compose-shadow-report.mjs",
    "ci:layer1:install-alias": "bash ../scripts/run-org-ci.sh install-layer1-push-alias.sh",
    "check:org-leak": "bash ../scripts/check-no-org-leak.sh",
    "setup:org-dx": "bash ../scripts/setup-org-dx.sh",
    "teardown:org-dx": "bash ../scripts/teardown-org-dx.sh",
    "merge:org-dev": "bash ../scripts/merge-org-dev.sh",
    "ensure:config": "bash ../scripts/ensure-ring-config.sh"
  },

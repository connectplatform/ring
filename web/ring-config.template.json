  "database": {
    "backendMode": "k8s-postgres-fcm",
    "schemaPrefix": "my_ring_clone",
    "poolSize": 20,
    "connectionTimeout": 30000,
    "retries": 3
  },
  "storage": {
    "provider": "ring_filebase",
    "maxFileSize": "10MB",
    "allowedMimeTypes": [
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/webp",
      "application/pdf",
      "video/mp4"
    ],
    "note": "SSOT for file(). ring_filebase via RINGBASE_API_URL. Env NEXT_PUBLIC_STORAGE_PROVIDER overrides. webpDerivative.provider=ringbase matches RingBase native ladders (upload-core also requests derivativesProfile when storage.provider is ring_filebase).",
    "webpDerivative": {
      "provider": "ringbase",
      "maxEdge": 1600,
      "quality": 82,
      "_comment": "off | sharp | ringbase — ringbase is default for ring_filebase mode; sharp only if opted in; off disables post-upload deriveWebpSibling"
    }
  },
  "security": {
    "rateLimiting": {
      "authWindowMs": 60000,
      "authMaxRequests": 5,
      "apiWindowMs": 60000,
      "apiMaxRequests": 100
    },
    "cors": {
      "allowedOrigins": [
        "https://your-domain.com"
      ],
      "allowCredentials": true
    },
    "csp": {
      "enabled": true,
      "reportUri": "/api/csp-report"
    }
  },
  "deployment": {
    "platform": "kubernetes",
    "namespace": "my-ring-clone",
    "replicas": 2,
    "resources": {
      "requests": {
        "cpu": "500m",
        "memory": "512Mi"
      },
      "limits": {
        "cpu": "1000m",
        "memory": "1Gi"
      }
    },
    "autoscaling": {
      "enabled": false,
      "minReplicas": 2,
      "maxReplicas": 10,
      "targetCPUUtilization": 80
    }
  },
  "matcher": {
    "scoreThreshold": 0.7,

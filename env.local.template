# =============================================================================
# EMAIL CRM — AI-assisted community inbox (IMAP poll + admin UI)
# =============================================================================
# Copy into .env.local. Public docs: docs/en/library/features/email-ai-crm.mdx
# Ringdom production ops (info@ringdom.org, k8s): data/migrations/EMAIL-CRM-OPS.md

# IMAP (inbound)
# --- Email CRM multi-mailbox (ring-config.emailCrm.channels) ---
# AUTH outbound (OTP/magic) uses SMTP_* / lib/mailer — keep separate from CRM.
# Per-channel secrets (id "primary" → CRM_CHANNEL_PRIMARY_*):
# CRM_CHANNEL_PRIMARY_PASSWORD=
# CRM_CHANNEL_PRIMARY_SMTP_PASSWORD=
# Legacy single-mailbox fallback (used when emailCrm.channels empty):
# IMAP_HOST=mail.example.com
# IMAP_PORT=993
# IMAP_TLS=true
# IMAP_TLS_REJECT_UNAUTHORIZED=false
# IMAP_USER=info@example.com
# IMAP_PASSWORD=

# SMTP (outbound — Ring Mailer SSOT for CRM replies + auth when SMTP_USER is shared)
# Prefer a dedicated noreply@ mailbox for auth; CRM may use info@
# SMTP_HOST=mail.ringdom.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=info@ringdom.org
# SMTP_PASSWORD=
# SMTP_FROM=Ringdom <info@ringdom.org>

# RingdomX Mail modes for white-label clones (Owner Secrets / calculator mail add-on):
# MAIL_MODE=ringdom   # MX points at mail.ringdom.org (Ringdom hosted)
# MAIL_MODE=byo       # Buyer brings own SMTP_* credentials

# ANTHROPIC_API_KEY=   # intent, sentiment, draft generation

# Processing
# EMAIL_POLLING_INTERVAL=30000
# EMAIL_BATCH_SIZE=10
# EMAIL_MAILBOX=INBOX
# EMAIL_PROCESSED_FOLDER=Processed
# EMAIL_SPAM_FOLDER=Spam

# Persistence: omit for Postgres JSONB (default); set memory for dev/tests without DB tables
# EMAIL_CRM_PERSISTENCE=memory

# Support desk — comma-separated Ring user ids auto-joined to new support chats + notified
# CRM_SUPPORT_DESK_USER_IDS=uuid-admin-1,uuid-admin-2

# Auto-send: keep false until SMTP smoke test passes
# EMAIL_AUTO_SEND_ENABLED=false

# Optional IDLE worker on Node boot (instrumentation.ts); prefer cron poll in production
# EMAIL_PROCESSOR_AUTOSTART=false
# EMAIL_PROCESSOR_ALLOW_HTTP_START=false

# Inbound webhook: POST /api/webhooks/email/inbound (Bearer or X-Email-Webhook-Signature HMAC)
# WEBHOOK_EMAIL_SECRET=generate-a-long-random-string

# =============================================================================
# CRON JOBS (optional — protect /api/cron/* routes)
# =============================================================================

# CRON_SECRET=generate-a-long-random-string
# Refcodes mint: GET /api/cron/refcodes-mint with Authorization: Bearer $CRON_SECRET
# Email CRM poll: POST /api/cron/email-processor body {"action":"poll"} (every 1-5m in production)
# Email analytics: GET /api/cron/email-analytics

# =============================================================================
# BACKUP, COMPLIANCE, CDN (optional)
# =============================================================================

# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30
# GDPR_ENABLED=true
# COOKIE_CONSENT_ENABLED=true
# CDN_ENABLED=false
# CDN_URL=https://cdn.ring-platform.org

# =============================================================================
# PUSH NOTIFICATIONS — Firebase FCM Web Push certificate (SHIPPED)
# =============================================================================
# Browser FCM token subscribe uses NEXT_PUBLIC_FIREBASE_VAPID_KEY (listed in the
# FIREBASE CLIENT SDK section above). That value is a Firebase Console
# → Project Settings → Cloud Messaging → Web Push certificates public key.
# MUST be generated for the SAME Firebase project as NEXT_PUBLIC_FIREBASE_PROJECT_ID.
# Do NOT reuse ring-main VAPID (BKQ4OAwA…) in ring-platform or other clone projects.
# This is NOT an app-owned RFC 8292 VAPID keypair and is NOT for the web-push npm library.

# =============================================================================
# RFC WEB PUSH (web-push library) — planned dual-stack; not FCM
# =============================================================================
# App-owned VAPID keypair for the web-push npm package (RFC Web Push).
# DISTINCT from NEXT_PUBLIC_FIREBASE_VAPID_KEY / Firebase Web Push certificates.
# Do NOT paste the Firebase certificate into these variables.
# Generate with: npx web-push generate-vapid-keys
# Status: planned dual-stack — web-push is not installed yet; no services/push or push-sw.js.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@your-domain.example

# =============================================================================
# SOCIAL & EXPERIMENTAL (optional)
# =============================================================================

# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-slack-webhook
# EXPERIMENTAL_AI_INSIGHTS=false

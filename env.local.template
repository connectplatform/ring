# =============================================================================
# RING ORDER LAB / EDGE (CRM custom order deploy control panel)
# =============================================================================
# Scoped Kubernetes ServiceAccount tokens for Order Lab deploy widget.
# RBAC: get/list/watch/patch secrets,configmaps,deployments,pods; get pods/log; delete pods.
# US default = k3s-or (5.78.193.246). FI = k3s-3 Finland (135.181.161.60) — BuildKit/Forgejo live here. UA = k8s-1 Cherkasy.
# Legacy k3s-2 (65.21.152.63) is retired for Order Lab FI edge.
# RING_EDGE_US_API_URL=https://5.78.193.246:6443
# RING_EDGE_US_TOKEN=
# RING_EDGE_US_NAMESPACE=
# RING_EDGE_FI_API_URL=https://135.181.161.60:6443  # k3s-3 Finland (NOT legacy k3s-2)
# RING_EDGE_FI_TOKEN=
# RING_EDGE_FI_NAMESPACE=
# RING_EDGE_UA_API_URL=https://195.95.233.69:6443
# RING_EDGE_UA_TOKEN=
# RING_EDGE_UA_NAMESPACE=
# Opt-in: allow self-signed / private-CA Kubernetes API TLS (k3s). Default off.
# RING_EDGE_TLS_INSECURE=true
# Forgejo OCI pull robot (Order Lab ensureForgejoRegistryPullSecret)
# RING_FORGEJO_PULL_USER=k8s-pull
# RING_FORGEJO_PULL_TOKEN=
# Forgejo Contents/Commits API (Order Source Editor — must be on the Next.js app pod, not only BuildKit)
# Mesh-only Ingress: public DNS (ring-ns) stays on VIP → 403; in-mesh peers → 200/401.
# Prod pods: Deployment hostAliases forge/registry → 100.64.0.1 (do not rewrite ring-ns A records).
# Local Mac on ring-mesh: optional /etc/hosts `100.64.0.1 forge.ringdom.org registry.ringdom.org`
#   OR port-forward: kctl k3s-3 -n forgejo port-forward svc/forgejo 3000:3000
#   then RING_FORGEJO_API_URL=http://127.0.0.1:3000
# RING_FORGEJO_API_URL=https://forge.ringdom.org
# RING_FORGEJO_API_TOKEN=   # org robot PAT (order-lab-write) — fallback if per-order mint unavailable
# Layer1 platform git for Order Lab Build Jobs (Forgejo repo name: ring)
# RING_PLATFORM_GIT_URL=https://forge.ringdom.org/ringdom/ring.git
# Forgejo OCI registry SSOT (replaces ghcr.io) — ring prod / Lab deploy
# RING_DOCKER_REGISTRY=registry.ringdom.org
# RING_DOCKER_NAMESPACE=ringdom
# RING_DOCKER_IMAGE=ring
# Admin BasicAuth for lazy per-order robot + PAT mint (Order Source Editor isolation)
# RING_FORGEJO_ADMIN_USER=
# RING_FORGEJO_ADMIN_PASSWORD=
# Monthly PAT rotate (ProcessConductor forgejo-token-rotate): age threshold + per-run cap
# FORGEJO_TOKEN_ROTATE_MAX_AGE_DAYS=30
# FORGEJO_TOKEN_ROTATE_LIMIT=50
# Optional dedicated key for encrypting Order Lab secrets at rest (defaults to WALLET_ENCRYPTION_KEY)
# ORDER_LAB_ENCRYPTION_KEY=

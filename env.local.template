NEXT_PUBLIC_RING_DEPLOY_TARGET=self-hosted
# Hub broker: memory (local dev) | k8s-postgres (prod label) | redis | connect (future)
# TUNNEL_HUB_MODE=memory
# Cross-pod publish fan-out via Postgres LISTEN/NOTIFY (default disabled — zero overhead at 1 replica).
# Requires TUNNEL_HUB_MODE=k8s-postgres. Enable only when scaling replicas > 1 after smoke.
# TUNNEL_POSTGRES_FANOUT=disabled
# TUNNEL_NOTIFY_CHANNEL=ring_tunnel_fanout
# Optional override for LISTEN self-echo skip (tests / multi-process on same host)
# TUNNEL_INSTANCE_ID=
# Optional explicit WS URL (default: same host /api/tunnel/ws)
# NEXT_PUBLIC_TUNNEL_WS_URL=wss://ring-platform.org/api/tunnel/ws
# Tunnel JWT signing (optional — defaults to AUTH_SECRET in dev and prod)
# TUNNEL_JWT_SECRET=
# Phase 3 collaboration (requires non-vercel deploy target)
# NEXT_PUBLIC_COLLAB_ENABLED=true


      "accent": "#8b5cf6",
      "accentForeground": "#ffffff",
      "background": "#ffffff",
      "foreground": "#0f172a",
      "muted": "#f1f5f9",
      "mutedForeground": "#64748b",
      "destructive": "#ef4444",
      "destructiveForeground": "#ffffff",
      "border": "#e2e8f0",
      "input": "#e2e8f0",
      "ring": "#6366f1"
    },

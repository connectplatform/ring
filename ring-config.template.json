    "payments": {
      "enabled": true,
      "provider": "wayforpay",
      "subscriptionPlans": [
        "free",
        "subscriber",
        "member",
        "confidential"
      ]
    },
    "web3": {
      "enabled": true,
      "walletConnect": true,
      "ringToken": true,
      "nftMarketplace": false,
      "nftGates": true,
      "staking": false,
      "defaultChain": "solana"
    },
    "messaging": {
      "enabled": true,
      "realtime": true,
      "fileSharing": true
    },
    "notifications": {
      "push": true,
      "email": true,
      "inApp": true
    },
    "ai": {
      "enabled": true,
      "matcher": true,
      "productConsultant": false
    },
    "analytics": {
      "enabled": true,
      "webVitals": true,
      "googleAnalytics": false,
      "mixpanel": false
    },
    "expertServicesMarketplace": false
  },
  "theme": {
    "default": "system"
  },
  "navigation": {
    "links": [
      {
        "label": "Home",
        "href": "/"
      },
      {
        "label": "Entities",
        "href": "/entities"
      },
      {
        "label": "Opportunities",
        "href": "/opportunities"
      }
    ]
  },
  "hero": {
    "title": "Your platform name",
    "subtitle": "One-line value proposition for your community or marketplace.",
    "ctaText": "Get started",
    "ctaHref": "/register",
    "showOnHome": true
  },
  "platform": {
    "baseUrl": "https://your-domain.com"
  },
  "tokens": {
    "creditUnit": "USD",
    "creditFiatCurrency": "USD",
    "creditAddEvents": {
      "adminVerify": {
        "amount": "1",
        "enabled": true,
        "requireUsername": true
      },
      "ringUsername": {
        "amount": "1",
        "enabled": true,
        "requireVerified": true
      }
    },
    "desk": {
      "supplyPolicy": "treasury_transfer",
      "sellTaxBps": 500,
      "sellTaxDestination": "treasury_ata",
      "firstSettlerDiscountBps": 2000,
      "firstSettlerOneTime": true,
      "firstSettlerGates": [
        "wallet",
        "username",
        "dob",
        "verified"
      ],
      "quoteTtlSeconds": 60,
      "maxSlippageBps": 100
    },
    "nativeToken": {
      "symbol": "RING",
      "name": "RING Governance Token",
      "decimals": 8,
      "tokenAddress": "AsPZxBXXPPYefrdSqMsC89SBycD4KASLEm9bXX22dUHv",
      "tokenDecimals": 8,
      "tokenProgram": "spl-token"
    }
  },
  "sidebar": {
    "quickLinks": [
      {
        "labelKey": "about.sidebar.aboutUs",
        "href": "/about",
        "icon": "Info"
      },
      {
        "labelKey": "about.sidebar.tokenEconomy",
        "href": "/token-economy",
        "icon": "Globe"
      },
      {
        "labelKey": "about.sidebar.globalImpact",
        "href": "/global-impact",
        "icon": "Users"
      },
      {
        "labelKey": "about.sidebar.contact",
        "href": "/contact",
        "icon": "Mail"
      }

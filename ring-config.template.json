  "calculator": {
    "enabled": true,
    "presetId": "deployment"
  },
  "roadmap": {
    "enabled": true
  },
  "productFields": {
    "preset": "platform"
  },
  "productBadges": {
    "preset": "platform"
  },
  "contact": {
    "address": "123 Main Street, City, Country",
    "phone": "+1 000 000 0000",
    "email": "contact@your-domain.com"
  },
  "localization": {
    "defaultLocale": "en",
    "supportedLocales": [
      "en",
      "uk",
      "ru"
    ],
    "fallbackLocale": "en",
    "dateFormat": "MMMM d, yyyy",
    "timeFormat": "HH:mm",
    "timezone": "UTC"
  },
  "seo": {
    "siteName": "My Ring Clone",
    "siteDescription": "Professional networking platform powered by Ring",
    "siteKeywords": [
      "professional networking",
      "opportunities",
      "business",
      "web3"
    ],
    "ogImage": "/og-ring-platform-1200x630.jpg",
    "twitterHandle": "@your_handle",
    "googleSiteVerification": "",
    "bingSiteVerification": ""
  },
  "social": {
    "twitter": "https://twitter.com/your_handle",
    "linkedin": "https://linkedin.com/company/your-company",
    "github": "https://github.com/your-org",
    "discord": "https://discord.gg/your-invite",
    "telegram": "https://t.me/your_channel"
  },
  "legal": {
    "companyName": "Your Company Name",
    "companyAddress": "123 Main Street, City, Country",
    "companyRegistration": "REG-12345678",
    "licenseSpdx": "MIT",
    "privacyPolicyUrl": "/legal/privacy",
    "termsOfServiceUrl": "/legal/terms",
    "cookiePolicyUrl": "/legal/cookies",
    "gdprEnabled": true,
    "ccpaEnabled": false
  },
  "database": {
    "backendMode": "k8s-postgres-fcm",
    "schemaPrefix": "my_ring_clone",
    "poolSize": 20,
    "connectionTimeout": 30000,
    "retries": 3
  },
  "storage": {
    "provider": "ring_filebase",
    "maxFileSize": "10MB",
    "allowedMimeTypes": [
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/webp",
      "application/pdf",
      "video/mp4"
    ],
    "note": "SSOT for file(). ring_filebase via RINGBASE_API_URL. Env NEXT_PUBLIC_STORAGE_PROVIDER overrides."
  },
  "security": {
    "rateLimiting": {
      "authWindowMs": 60000,
      "authMaxRequests": 5,
      "apiWindowMs": 60000,
      "apiMaxRequests": 100
    },
    "cors": {
      "allowedOrigins": [
        "https://your-domain.com"
      ],
      "allowCredentials": true
    },
    "csp": {
      "enabled": true,
      "reportUri": "/api/csp-report"
    }
  },
  "deployment": {
    "platform": "kubernetes",
    "namespace": "my-ring-clone",
    "replicas": 2,
    "resources": {
      "requests": {
        "cpu": "500m",
        "memory": "512Mi"
      },
      "limits": {
        "cpu": "1000m",
        "memory": "1Gi"
      }
    },
    "autoscaling": {
      "enabled": false,
      "minReplicas": 2,
      "maxReplicas": 10,
      "targetCPUUtilization": 80
    }
  },
  "matcher": {
    "scoreThreshold": 0.7,
    "maxMatches": 10,
    "autoApprove": false,
    "autoApproveMinScore": 0.7,
    "llmConfidenceGate": 0.8
  },
  "publicPools": {
    "minGoalHours": 1,
    "ringPerMachineHour": 1,
    "likeQueueThreshold": 100
  },
  "membership": {
    "tiers": {
      "subscriber": {
        "amount": 0,
        "currency": "UAH",
        "description": "Ring Platform Subscriber (Free)",

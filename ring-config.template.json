  "domains": {
    "production": "https://your-domain.com",
    "staging": "https://staging.your-domain.com",
    "development": "http://localhost:3000",
    "cdn": "https://cdn.your-domain.com",
    "api": "https://api.your-domain.com"
  },
  "features": {
    "entities": {
      "enabled": true,
      "types": [
        "company",
        "startup",
        "organization",
        "ngo",
        "agency"
      ]
    },
    "opportunities": {
      "enabled": true,
      "types": [
        "offer",
        "request",
        "ring_customization"
      ],
      "accessTiers": [
        "public",
        "subscriber",
        "member",
        "confidential"
      ]
    },
    "store": {
      "enabled": true,
      "multiVendor": true,
      "currency": "USD",
      "currencySymbol": "$",
      "taxEnabled": false,
      "taxRate": 0

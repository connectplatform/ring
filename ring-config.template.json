      "primary": "#818cf8",
      "primaryForeground": "#0f172a",
      "secondary": "#1e293b",
      "secondaryForeground": "#f8fafc",
      "accent": "#a78bfa",
      "accentForeground": "#0f172a",
      "background": "#0f172a",
      "foreground": "#f8fafc",
      "muted": "#1e293b",
      "mutedForeground": "#94a3b8",
      "destructive": "#f87171",
